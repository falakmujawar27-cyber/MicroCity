                <mxCell id="kicker-source" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4235A8;fontSize=11;fontStyle=1;spacing=0;" value="01 · CAPTURE" vertex="1">
                    <mxGeometry height="20" width="265" x="65" y="162" as="geometry"/>
                </mxCell>
                <mxCell id="text-source" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacing=0;" value="&lt;b&gt;College evidence enters&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Estates/admin records and imports&lt;br&gt;Rooms, meters, attendance, assets&lt;br&gt;Student/faculty issue reports&lt;/font&gt;" vertex="1">
                    <mxGeometry height="91" width="270" x="65" y="188" as="geometry"/>
                </mxCell>
                <mxCell id="kicker-gate" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4235A8;fontSize=11;fontStyle=1;spacing=0;" value="02 · AUTHORIZE + VALIDATE" vertex="1">
                    <mxGeometry height="20" width="280" x="435" y="162" as="geometry"/>
                </mxCell>
                <mxCell id="text-gate" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacing=0;" value="&lt;b&gt;Node.js API checks each request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Session and role capability&lt;br&gt;Input types, limits and ownership&lt;br&gt;College membership rechecked server-side&lt;/font&gt;" vertex="1">
                    <mxGeometry height="91" width="270" x="435" y="188" as="geometry"/>
                </mxCell>
                <mxCell id="kicker-store" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8A5A16;fontSize=11;fontStyle=1;spacing=0;" value="03 · STORE WITH PROVENANCE" vertex="1">
                    <mxGeometry height="20" width="280" x="805" y="162" as="geometry"/>
                </mxCell>
                <mxCell id="text-store" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacing=0;" value="&lt;b&gt;SQLite record and audit trail&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Campus rows stay college-scoped&lt;br&gt;Public/shared records stay distinct&lt;br&gt;Missing values remain missing&lt;/font&gt;" vertex="1">
                    <mxGeometry height="91" width="270" x="805" y="188" as="geometry"/>
                </mxCell>
                <mxCell id="kicker-analysis" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4235A8;fontSize=11;fontStyle=1;spacing=0;" value="04 · CALCULATE FIRST" vertex="1">
                    <mxGeometry height="20" width="275" x="1175" y="162" as="geometry"/>
                </mxCell>
                <mxCell id="text-analysis" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacing=0;" value="&lt;b&gt;Deterministic analysis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Capacity and needs · resource readings&lt;br&gt;Condition and maintenance priority&lt;br&gt;Findings carry facts and limitations&lt;/font&gt;" vertex="1">
                    <mxGeometry height="91" width="275" x="1175" y="188" as="geometry"/>
                </mxCell>
                <mxCell id="planning-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#4235A8;fontSize=13;fontStyle=1;spacing=0;" value="PLANNING LOOP  ·  Review evidence, record a human decision, feed the next cycle" vertex="1">
                    <mxGeometry height="25" width="900" x="50" y="122" as="geometry"/>
                </mxCell>
                <mxCell id="plan-new-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;New evidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Implement an approved option, add a reading, or import an updated record. It enters the next analysis cycle with its source and basis.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="108" width="280" x="65" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="plan-report-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;Plan, report, print&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Create a point-in-time report with Measured, Estimated, Illustrative or Missing basis tags. New evidence starts the next cycle.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="108" width="280" x="435" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="plan-decision-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;Review and decide&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Estates reviews evidence and trade-offs. Only an administrator records approve, reject or defer, with actor and time.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="108" width="280" x="805" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="plan-findings-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=13;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;Findings with evidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;People review the calculated gap, threshold, source, basis and missing data before choosing an option. No automatic recommendation.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="108" width="280" x="1175" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="cycle-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#B9B0E8;fontColor=#4235A8;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="NEXT PLANNING CYCLE" vertex="1">
                    <mxGeometry height="22" width="190" x="460" y="321" as="geometry"/>
                </mxCell>
                <mxCell id="issue-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8A5A16;fontSize=13;fontStyle=1;spacing=0;" value="ISSUE + MAINTENANCE LOOP  ·  The reporter can follow the same ticket through evidence-backed work" vertex="1">
                    <mxGeometry height="25" width="1000" x="50" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="issue-report-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=12;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Reporter files an issue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Student or faculty gives a description and a room (or Not sure). A photo is optional.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="226" x="62" y="659" as="geometry"/>
                </mxCell>
                <mxCell id="issue-ticket-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=12;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Validate and ticket&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;API checks college scope and fields, then saves a ticket and audit history.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="226" x="352" y="659" as="geometry"/>
                </mxCell>
                <mxCell id="issue-triage-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=12;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Triage and assign&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Staff reviews category and severity, sees server-computed similar reports and assigns an owner.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="226" x="642" y="659" as="geometry"/>
                </mxCell>
                <mxCell id="issue-work-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=12;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Work with evidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;Maintenance updates status in order and records a work note; completion may include an after photo.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="226" x="932" y="659" as="geometry"/>
                </mxCell>
                <mxCell id="issue-track-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=12;spacingLeft=10;spacingRight=10;" value="&lt;b&gt;Reporter tracks progress&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#595465&quot;&gt;The same ticket and history remain visible to the reporter. The verified update can inform future analysis.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="226" x="1222" y="659" as="geometry"/>
                </mxCell>
                <mxCell id="issue-feedback-label" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#E6C780;fontColor=#8A5A16;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="WORK NOTE + STATUS FEED FUTURE EVIDENCE" vertex="1">
                    <mxGeometry height="22" width="360" x="535" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="ai-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8A5A16;fontSize=11;fontStyle=1;spacing=0;" value="OPTIONAL AI · EXPLANATION AND SUGGESTION ONLY" vertex="1">
                    <mxGeometry height="20" width="680" x="68" y="844" as="geometry"/>
                </mxCell>
                <mxCell id="ai-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15131F;fontSize=11;spacing=0;" value="Finding/report explanations use server-computed facts; intake suggestions are allow-list checked and user-confirmed; Ask Your Data maps a fixed lookup and never sees its result. Number-guarded AI is labelled “AI-generated, please verify”." vertex="1">
                    <mxGeometry height="43" width="690" x="68" y="868" as="geometry"/>
                </mxCell>
                <mxCell id="guard-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#F9B318;fontSize=11;fontStyle=1;spacing=0;" value="AUTHORIZATION · COLLEGE SCOPE · AUDIT" vertex="1">
                    <mxGeometry height="20" width="610" x="825" y="844" as="geometry"/>
                </mxCell>
                <mxCell id="guard-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#E8E4D3;fontSize=11;spacing=0;" value="Every request is checked server-side. College records stay isolated. Create, update, import and decision actions record actor/time; AI cannot calculate, authorize, prioritize or change records." vertex="1">
                    <mxGeometry height="43" width="625" x="825" y="868" as="geometry"/>
                </mxCell>
                <mxCell id="footer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#595465;fontSize=11;fontStyle=1;spacing=0;" value="MICROCITY  ·  FROM RECORDED EVIDENCE TO ACCOUNTABLE ACTION" vertex="1">
                    <mxGeometry height="24" width="1100" x="50" y="946" as="geometry"/>
                </mxCell>
                <mxCell id="legend-plan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5245F8;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="PLANNING" vertex="1">
                    <mxGeometry height="25" width="110" x="1200" y="944" as="geometry"/>
                </mxCell>
                <mxCell id="legend-issue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9B318;strokeColor=none;fontColor=#15131F;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="ISSUES" vertex="1">
                    <mxGeometry height="25" width="110" x="1320" y="944" as="geometry"/>
                </mxCell>
